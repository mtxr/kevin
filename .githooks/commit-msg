#!/bin/sh
# Enforces: English/ASCII-only text and Conventional Commits subjects.
# Install with: kevin -f CONTRIBUTING.md hooks
msg_file=$1
subject=$(head -n 1 "$msg_file")

case "$subject" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

if LC_ALL=C grep -q '[^[:print:][:space:]]' "$msg_file"; then
  echo "commit-msg: only plain ASCII (English) text is allowed in commit messages" >&2
  exit 1
fi

if ! printf '%s\n' "$subject" | grep -Eq '^(feat|fix|docs|chore|refactor|test|build|ci|perf|style)(\([a-z0-9._-]+\))?!?: .+'; then
  echo "commit-msg: subject must look like 'type(scope): summary' (see CONTRIBUTING.md)" >&2
  exit 1
fi

if [ "${#subject}" -gt 72 ]; then
  echo "commit-msg: subject is longer than 72 characters" >&2
  exit 1
fi
